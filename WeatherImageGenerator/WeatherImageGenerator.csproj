<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416;CS8618;CS0169;CS0649;CS0414;CS0067;CS0618</NoWarn>
    <Version>1.20.47.0406</Version>
    <AssemblyVersion>1.20.47.0406</AssemblyVersion>
    <FileVersion>1.20.47.0406</FileVersion>
    <RootNamespace>WeatherImageGenerator</RootNamespace>
    <AssemblyName>WSG</AssemblyName>
    <AssemblyCompany>NoID Softwork</AssemblyCompany>
    <AssemblyProduct>Weather Image Generator</AssemblyProduct>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>WSG.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenMeteo\OpenMeteo.csproj" />
    <ProjectReference Include="..\WeatherShared\WeatherShared.csproj" />
    <ProjectReference Include="..\ECCC\ECCC.csproj" />
    <ProjectReference Include="..\EKCA\EKCA.csproj" />
    <ProjectReference Include="..\EAS\EAS.csproj" />
    <ProjectReference Include="..\OpenMap\OpenMap.csproj" />
    <ProjectReference Include="..\Grib2\Grib2.csproj" />
    <ProjectReference Include="..\BZTG\BZTG.csproj" />
    <!-- Include the updater helper executable -->
    <ProjectReference Include="..\WeatherImageGenerator.Updater\WeatherImageGenerator.Updater.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- appsettings.json is NOT included in publish/release; the app generates it at runtime -->
    <None Include="appsettings.json" />
    <!-- Copy wwwroot files for Web UI -->
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Rendering\DirectX\shaders\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Rendering\OpenGL\shaders\**\*.*" />
    <EmbeddedResource Include="Rendering\Vulkan\shaders\**\*.*" />
    <EmbeddedResource Include="Rendering\DirectX\shaders\**\*.*" />
