    <Compile Remove="Rendering\Vulkan\**\*.cs" />
    <!-- Embed icons into the binary -->
    <EmbeddedResource Include="WeatherImages\Icons\*.png" />
    <!-- Embed application icon so runtime does not rely on an external file -->
    <EmbeddedResource Include="WSG.ico" />
    <Content Include="Music\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude Icons from being copied to output since they're embedded -->
    <None Remove="WeatherImages\Icons\**" />
    <Content Remove="WeatherImages\Icons\**" />
    <Compile Remove="WeatherImages\Icons\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
    <PackageReference Include="OpenTK.WinForms" Version="4.0.0-pre.8" />
    <PackageReference Include="OpenTK.Graphics" Version="4.8.2" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.22.0" />
  </ItemGroup>
  <!-- Copy the updater executable to the output directory -->
  <Target Name="CopyUpdater" AfterTargets="Build">
    <Copy SourceFiles="..\WeatherImageGenerator.Updater\bin\$(Configuration)\net10.0\WSG.Updater.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>