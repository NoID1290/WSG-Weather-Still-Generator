<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WSG.Mobile.Pages.ForecastPage"
             Title="Forecast">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
        <HorizontalStackLayout Spacing="12">
            <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                <Label Text="7-Day Forecast"
                       FontAttributes="Bold"
                       FontSize="22" />
                <Label Text="{Binding LocationDisplay}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <Button Text="Refresh"
                    Clicked="OnRefreshClicked"
                    IsEnabled="{Binding IsNotBusy}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ForecastDays}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6">
                    <Label Text="No forecast loaded yet."
                           FontAttributes="Bold" />
                    <Label Text="Use Refresh to load the latest forecast for your saved location."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="{Binding WeatherIcon}"
                                   FontSize="28"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding DayLabel}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding Summary}"
                                       FontSize="14" />
                                <Label Text="{Binding TemperatureRange}"
                                       FontSize="14"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Extras}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
