<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WSG.Mobile.Pages.ForecastPage"
             Title="Forecast">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
        <HorizontalStackLayout Spacing="12">
            <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                <Label Text="7-Day Forecast"
                       FontAttributes="Bold"
                       FontSize="22" />
                <Label Text="{Binding LocationQuery}"
                       FontSize="14"
                       TextColor="#475569" />
            </VerticalStackLayout>

            <Button Text="Refresh"
                    Clicked="OnRefreshClicked"
                    IsEnabled="{Binding IsNotBusy}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ForecastDays}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6">
                    <Label Text="No forecast loaded yet."
                           FontAttributes="Bold" />
                    <Label Text="Use Refresh to load the latest forecast for your saved location."
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DayLabel}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Text="{Binding Summary}"
                                   FontSize="14" />
                            <Label Text="{Binding TemperatureRange}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding Extras}"
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
