<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WSG.Mobile.Controls"
             x:Class="WSG.Mobile.Pages.RadarPage"
             Title="Radar"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="RootGrid">

        <!-- ── Full-screen OpenGL ES radar map ───────────────────────────── -->
        <controls:RadarGLView x:Name="RadarView"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              RadarOpacity="0.7" />

        <!-- ── Top floating toolbar ──────────────────────────────────────── -->
        <Border VerticalOptions="Start"
                HorizontalOptions="Fill"
                Margin="10,44,10,0"
                Padding="10,8"
                BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD1E293B}"
                StrokeShape="RoundRectangle 14"
                Stroke="{AppThemeBinding Light=#22000000, Dark=#33FFFFFF}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2">

                <!-- Title -->
                <Label Text="Weather Radar"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                       VerticalOptions="Center"
                       Margin="4,0" />

                <!-- Re-center -->
                <Button Grid.Column="1"
                        x:Name="BtnCenterLocation"
                        Text="📍"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        Padding="4"
                        WidthRequest="40" HeightRequest="38"
                        Clicked="OnCenterClicked"
                        ToolTipProperties.Text="Re-center" />

                <!-- Toggle radar overlay -->
                <Button Grid.Column="2"
                        x:Name="BtnToggleRadar"
                        Text="🛰️"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        Padding="4"
                        WidthRequest="40" HeightRequest="38"
                        Clicked="OnToggleRadarClicked"
                        ToolTipProperties.Text="Toggle radar" />

                <!-- Play / Pause animation -->
                <Button Grid.Column="3"
                        x:Name="BtnPlayPause"
                        Text="▶️"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        Padding="4"
                        WidthRequest="40" HeightRequest="38"
                        Clicked="OnPlayPauseClicked"
                        ToolTipProperties.Text="Play / Pause" />

                <!-- Lightning toggle -->
                <Button Grid.Column="4"
                        x:Name="BtnLightning"
                        Text="⚡"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        Padding="4"
                        WidthRequest="40" HeightRequest="38"
                        Clicked="OnLightningToggleClicked"
                        ToolTipProperties.Text="Lightning" />

                <!-- Settings -->
                <Button Grid.Column="5"
                        x:Name="BtnSettings"
                        Text="⚙️"
                        FontSize="17"
                        BackgroundColor="Transparent"
                        Padding="4"
                        WidthRequest="40" HeightRequest="38"
                        Clicked="OnSettingsClicked"
                        ToolTipProperties.Text="Settings" />
            </Grid>
        </Border>

        <!-- ── Coordinates badge (shows briefly while panning) ───────────── -->
        <Border x:Name="CoordBadge"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,106,0,0"
                Padding="10,4"
                BackgroundColor="#CC000000"
                StrokeShape="RoundRectangle 10"
                Stroke="Transparent"
                Opacity="0">
            <Label x:Name="CoordLabel"
                   Text="0.0000°, 0.0000°"
                   TextColor="White"
                   FontSize="11"
                   FontFamily="OpenSansRegular" />
        </Border>

        <!-- ── Animation timeline panel ──────────────────────────────────── -->
        <Border x:Name="TimelinePanel"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="8,0,8,8"
                Padding="12,8"
                BackgroundColor="{AppThemeBinding Light=#DDFFFFFF, Dark=#DD1E293B}"
                StrokeShape="RoundRectangle 14"
                Stroke="{AppThemeBinding Light=#22000000, Dark=#33FFFFFF}"
                IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                <!-- Row 0: time label + frame counter -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="TimeLabel"
                           Text="--:--"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="FrameCounterLabel"
                           Text="0 / 0"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Row 1: progress slider (acts as timeline scrubber) -->
                <Slider Grid.Row="1"
                        x:Name="TimelineSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        ThumbColor="#2563EB"
                        MinimumTrackColor="#2563EB"
                        MaximumTrackColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                        ValueChanged="OnTimelineSliderChanged" />

                <!-- Row 2: speed label + controls -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Label Text="Speed"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                           VerticalOptions="Center" />
                    <Slider Grid.Column="1"
                            x:Name="SpeedSlider"
                            Minimum="150" Maximum="1000" Value="500"
                            ThumbColor="#2563EB"
                            MinimumTrackColor="#2563EB"
                            MaximumTrackColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                            ValueChanged="OnSpeedChanged" />
                    <Label Grid.Column="2"
                           x:Name="SpeedLabel"
                           Text="500ms"
                           FontSize="12"
                           WidthRequest="48"
                           VerticalOptions="Center" />
                    <!-- Reload button -->
                    <Button Grid.Column="3"
                            Text="↺"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                            Padding="6,0"
                            HeightRequest="34"
                            WidthRequest="36"
                            Clicked="OnReloadClicked"
                            ToolTipProperties.Text="Reload radar frames" />
                </Grid>
            </Grid>
        </Border>

        <!-- ── Settings sheet ────────────────────────────────────────────── -->
        <Border x:Name="SettingsPanel"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="8,0,8,8"
                Padding="14,12"
                BackgroundColor="{AppThemeBinding Light=#FDFEFF, Dark=#1E293B}"
                StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light=#22000000, Dark=#33FFFFFF}"
                IsVisible="False">
            <VerticalStackLayout Spacing="14">

                <!-- ── Header row ── -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Radar Settings"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="14"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                            Padding="6,0" HeightRequest="32" WidthRequest="32"
                            Clicked="OnSettingsClicked" />
                </Grid>

                <!-- ── Separator ── -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                <!-- ── Radar layer ── -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="🛰️ Layer"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                           VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            x:Name="RadarLayerPicker"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                            BackgroundColor="Transparent"
                            SelectedIndexChanged="OnRadarLayerChanged" />
                </Grid>

                <!-- ── Opacity ── -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="🔆 Opacity"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                           VerticalOptions="Center" />
                    <Slider Grid.Column="1"
                            x:Name="OpacitySlider"
                            Minimum="0" Maximum="1" Value="0.7"
                            ThumbColor="#2563EB"
                            MinimumTrackColor="#2563EB"
                            MaximumTrackColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                            ValueChanged="OnOpacityChanged" />
                    <Label Grid.Column="2"
                           x:Name="OpacityLabel"
                           Text="70%"
                           FontSize="13"
                           WidthRequest="36"
                           VerticalOptions="Center" />
                </Grid>

                <!-- ── Separator ── -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                <!-- ── Map Style ── -->
                <Label Text="Map Style"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                <HorizontalStackLayout Spacing="8" x:Name="MapStyleRow">
                    <!-- Populated from code-behind -->
                </HorizontalStackLayout>

                <!-- ── Separator ── -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                <!-- ── Lightning ── -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="⚡ Lightning"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                           VerticalOptions="Center" />
                    <Switch x:Name="LightningSwitch"
                            Grid.Column="1"
                            IsToggled="False"
                            Toggled="OnLightningSwitchToggled"
                            OnColor="#2563EB" />
                </Grid>

                <VerticalStackLayout x:Name="LightningOptions" IsVisible="False" Spacing="10">
                    <!-- CG / IC toggles -->
                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="6">
                        <Label Text="Cloud-to-Ground"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                               VerticalOptions="Center" />
                        <Switch x:Name="LightningCgSwitch"
                                Grid.Column="1"
                                IsToggled="True"
                                Toggled="OnLightningTypeChanged"
                                OnColor="#F59E0B" />
                        <Label Grid.Column="2"
                               Text="In-Cloud"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                               VerticalOptions="Center"
                               HorizontalOptions="End" />
                        <Switch x:Name="LightningIcSwitch"
                                Grid.Column="3"
                                IsToggled="True"
                                Toggled="OnLightningTypeChanged"
                                OnColor="#60A5FA" />
                    </Grid>
                    <!-- Time window -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Window"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="1"
                                x:Name="LightningWindowPicker"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnLightningWindowChanged" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- ── OSM attribution ────────────────────────────────────────────── -->
        <Label x:Name="AttributionLabel"
               Text="© OpenStreetMap contributors"
               VerticalOptions="End"
               HorizontalOptions="Start"
               Margin="6,0,0,8"
               FontSize="9"
               Opacity="0.55"
               TextColor="White" />

        <!-- ── Loading indicator ──────────────────────────────────────────── -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                           WidthRequest="40" HeightRequest="40" />

        <!-- ── No-data / error banner ─────────────────────────────────────── -->
        <Border x:Name="ErrorBanner"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="18,12"
                BackgroundColor="#CC1E293B"
                StrokeShape="RoundRectangle 12"
                Stroke="#33FFFFFF"
                IsVisible="False">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label x:Name="ErrorLabel"
                       Text="No radar data available"
                       TextColor="White"
                       FontSize="14"
                       HorizontalOptions="Center" />
                <Button Text="Retry"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="20,8"
                        Clicked="OnRetryClicked" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
