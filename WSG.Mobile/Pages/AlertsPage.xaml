<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WSG.Mobile.Pages.AlertsPage"
             Title="Alerts">

    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <HorizontalStackLayout Spacing="12">
            <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                <Label Text="⚠️ Weather Alerts"
                       FontAttributes="Bold"
                       FontSize="22" />
                <Label Text="{Binding AlertSummary}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <Button Text="Refresh"
                    Clicked="OnRefreshClicked"
                    IsEnabled="{Binding IsNotBusy}" />
        </HorizontalStackLayout>

        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Alerts}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="6">
                    <Label Text="No active alerts for this location."
                           FontAttributes="Bold" />
                    <Label Text="WSG Mobile will show severe watches, warnings, and advisories here."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#292524}"
                            Stroke="{Binding AccentColor}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Title}"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Severity}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding AccentColor}" />
                                <Label Text="{Binding Provider}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Region}"
                                   FontSize="13"
                                   FontAttributes="Italic"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Label Text="{Binding Summary}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
