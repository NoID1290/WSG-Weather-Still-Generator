<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WSG.Mobile.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="WSG Mobile"
                       FontAttributes="Bold"
                       FontSize="28" />
                <Label Text="Forecast, temperature, and weather alerts in one Android app."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <Border Padding="12"
                    BackgroundColor="{AppThemeBinding Light=#EEF6FF, Dark=#1E3A5F}"
                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#334155}"
                    StrokeShape="RoundRectangle 12"
                    Margin="0,0,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Location"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <Picker x:Name="LocationPicker"
                            Title="Select location"
                            SelectedIndexChanged="OnLocationChanged"
                            FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light=#EEF6FF, Dark=#1E3A5F}"
                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#334155}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding LocationDisplay}"
                           FontAttributes="Bold"
                           FontSize="20" />
                    <Label Text="{Binding LastUpdatedText}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}" />
                    <Button Text="Refresh Now"
                            Clicked="OnRefreshClicked"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#0B1120}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="{Binding CurrentTemperatureDisplay}"
                           FontAttributes="Bold"
                           FontSize="42"
                           TextColor="White" />
                    <Label Grid.Row="1"
                           Text="{Binding ConditionSummary}"
                           FontSize="18"
                           TextColor="#CBD5E1" />
                    <Label Grid.Column="1"
                           Grid.RowSpan="2"
                           Text="{Binding WeatherIcon}"
                           FontSize="48"
                           VerticalOptions="Center"
                           HorizontalOptions="End" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🌡️ Feels like"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label Text="{Binding FeelsLikeDisplay}"
                               FontAttributes="Bold"
                               FontSize="18" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💧 Humidity"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label Text="{Binding HumidityDisplay}"
                               FontAttributes="Bold"
                               FontSize="18" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💨 Wind"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label Text="{Binding WindDisplay}"
                               FontAttributes="Bold"
                               FontSize="18" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="🌧️ Precipitation"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label Text="{Binding PrecipitationDisplay}"
                               FontAttributes="Bold"
                               FontSize="18" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
